PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (add /velora before ?)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/velora?retryWrites=true&w=majority

# Long random string — change in production
JWT_SECRET=velora_dev_jwt_secret_change_me_please_32chars
JWT_EXPIRES_IN=7d

# Cloudinary dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CLIENT_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Seeded on first `npm run seed`
ADMIN_EMAIL=admin@shopnova.pk
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Shop Nova Admin
